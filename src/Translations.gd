class_name Translations
extends RefCounted

## Chooses the grammatically correct Russian plural form for a count, e.g.
## pluralizeRu(2, "раунд", "раунда", "раундов") -> "раунда".
static func pluralizeRu(count: int, one: String, few: String, many: String) -> String:
	var mod10 := count % 10
	var mod100 := count % 100
	if mod10 == 1 and mod100 != 11:
		return one
	if mod10 in [2, 3, 4] and not (mod100 in [12, 13, 14]):
		return few
	return many

